# File: MediGraph/.env.example
# Path: /Users/shweta/Desktop/major project fy/MediGraph/.env.example

# =============================================================================
# MediGraph Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --------- Frontend (React) ---------
# These are exposed to the browser, prefix with REACT_APP_

# Firebase Configuration (from Firebase Console > Project Settings > Web App)
REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789
REACT_APP_FIREBASE_APP_ID=1:123456789:web:abc123

# --------- ML Pipeline (Python) ---------
# These are server-side only, never expose to frontend

# Path to Firebase service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json

# Firebase project ID (same as above, for server-side use)
FIREBASE_PROJECT_ID=your_project_id

# --------- Optional ---------

# Environment (development/production)
NODE_ENV=development

# Cloudinary (if using for file storage)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
